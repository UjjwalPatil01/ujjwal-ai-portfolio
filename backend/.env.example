# Backend Application Configuration
APP_NAME="Ujjwal Patil AI/ML Portfolio API"
APP_ENV="development"
APP_VERSION="1.0.0"
DEBUG=false

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# Uses SQLite by default. On ephemeral cloud hosts (e.g. Render free tier),
# mount a persistent volume or switch DATABASE_URL to PostgreSQL.
SQLITE_DB_PATH="./data/portfolio.db"
DATABASE_URL=""

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000"

# Public Contact Endpoint Rate Limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Optional SMTP Notification Configuration (Not required for the app to run)
SMTP_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_TO_EMAIL="ujjwalpatil163@gmail.com"
